# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres, injected by the Vercel Marketplace integration.
DATABASE_URL=

# Server-side only. Never referenced from a client component.
ANTHROPIC_API_KEY=

# Vercel Blob, injected when the store is created.
BLOB_READ_WRITE_TOKEN=

# The passphrase the two of you type once per device.
WINO_PASSPHRASE=

# Random 32+ byte string used to sign the taster cookie.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WINO_COOKIE_SECRET=
